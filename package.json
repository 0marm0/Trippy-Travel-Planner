{
  "name": "trippy-travel-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "sample:build": "node scripts/build-public-sample.mjs",
    "sample:reconcile": "node --experimental-strip-types scripts/reconcile-public-sample.mjs",
    "sample:validate": "node scripts/validate-public-sample.mjs",
    "privacy:check": "sh scripts/public-release-preflight.sh",
    "history:check": "sh scripts/scan-git-history.sh",
    "maps:prepare": "node scripts/prepare-map-data.mjs",
    "postinstall": "npm run maps:prepare",
    "check": "npm run lint && npm run typecheck && npm test && npm run sample:validate && npm run schema:check && npm run build && npm run build:boundary:check && npm run privacy:check",
    "release:check": "npm run check && npm run history:check && npm run media:validate && npm run security:audit",
    "trip:init": "node --experimental-strip-types scripts/init-trip.mjs",
    "trip:validate": "node --experimental-strip-types scripts/validate-trip.mjs",
    "schema:check": "npm run trip:validate",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
    "dev:local": "next dev --hostname 127.0.0.1",
    "start:local": "next start --hostname 127.0.0.1",
    "media:prepare": "node scripts/prepare-public-media.mjs",
    "media:validate": "node scripts/validate-public-media.mjs",
    "build:boundary:check": "node scripts/check-build-boundary.mjs"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.7.7",
    "leaflet": "1.9.4",
    "maplibre-gl": "^6.9.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "acorn": "8.19.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "description": "A privacy-conscious planner for cash and points research, multi-city routes, itineraries and booking tracking.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0marm0/Trippy-Travel-Planner.git"
  },
  "homepage": "https://github.com/0marm0/Trippy-Travel-Planner#readme"
}
