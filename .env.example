# Copy this file to untracked .env.local. Keep placeholders only here.
# Never commit .env.local or paste a real value into chat, an issue, or a screenshot.

# Optional user-owned research keys. A configured value does not by itself enable
# an adapter, establish provider coverage, or prove a quote/booking exists.
SERPAPI_API_KEY=your_serpapi_key_here
SEATS_AERO_API_KEY=your_seats_aero_key_here
# Cached Search is the safe default for user-owned Pro keys. "live" requires a
# separate commercial agreement with Seats.aero; do not enable it for a Pro key.
SEATS_AERO_SEARCH_MODE=cached

# Reserved optional partner/OAuth adapter placeholders. Use only if you have
# independently approved access and a local/deployment adapter for that service.
BOOKING_COM_API_KEY=your_booking_demand_api_key_here
BOOKING_COM_AFFILIATE_ID=your_booking_affiliate_id_here
# Use production for approved live Demand API inventory or sandbox for simulated inventory.
BOOKING_COM_DEMAND_ENV=production
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# Gmail import is off unless this explicit gate and every required value are set.
# Generate a unique high-entropy value for the server-only session secret; never
# expose it through NEXT_PUBLIC_*, source control, logs, chat, or screenshots.
TRIPPY_ENABLE_GMAIL_IMPORT=false
TRIPPY_GMAIL_SESSION_SECRET=replace_with_at_least_32_random_characters

# Local application mode. The redacted sample is the safe default.
APP_BASE_URL=http://localhost:3000
DATA_MODE=sample

# Private itinerary import is development-only, loopback-only, and must never
# be enabled in a deployment. Keep the path outside this repository.
TRIPPY_ITINERARY_PATH=
# Optional normalized private 2026 dataset. When unset, local private mode
# checks the ignored .private/trips/europe-2026/trip.json path, followed by the
# legacy .private/2026-trip.json compatibility path.
TRIPPY_2026_DATA_PATH=
TRIPPY_ALLOW_PRIVATE_LOCAL=false

# Optional user contact for limited, user-initiated local place lookups.
TRIPPY_CONTACT_EMAIL=you@example.com

# Required before production visitors can spend configured provider quotas.
# Use separate high-entropy values; the session secret must be at least 32 characters.
TRIPPY_ACCESS_CODE=your_private_access_code_here
TRIPPY_SESSION_SECRET=your_high_entropy_session_secret_here

# Public browser configuration only. Never put a private provider secret in a
# NEXT_PUBLIC_* variable. Restrict any browser map key to intended domains/APIs.
# Optional public repository URL for a post-publication deploy link. Leave empty
# before the release gate passes; it is public metadata, not a credential.
NEXT_PUBLIC_TRIPPY_REPOSITORY_URL=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_CITY_MAP_STYLE_URL=
NEXT_PUBLIC_CITY_LIGHT_MAP_STYLE_URL=
NEXT_PUBLIC_SATELLITE_MAP_STYLE_URL=
NEXT_PUBLIC_CARTO_BASEMAP_KEY=your_restricted_browser_map_key_here
