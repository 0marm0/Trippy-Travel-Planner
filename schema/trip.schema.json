{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trippy/trip.schema.json",
  "title": "TRIPPY trip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "status",
    "dateWindow",
    "travelers",
    "origins",
    "destinations",
    "preferences",
    "anchors",
    "routeCandidates",
    "bookings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "idea",
        "planning",
        "selected",
        "traveling",
        "complete",
        "archived"
      ]
    },
    "dateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliestDeparture",
        "latestReturn",
        "flexDays"
      ],
      "properties": {
        "earliestDeparture": {
          "type": "string",
          "format": "date"
        },
        "latestReturn": {
          "type": "string",
          "format": "date"
        },
        "flexDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      }
    },
    "travelers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adults",
        "childrenAges"
      ],
      "properties": {
        "adults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "childrenAges": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17
          }
        }
      }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "code"
        ],
        "properties": {
          "kind": {
            "enum": [
              "airport",
              "station",
              "city"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 12
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "priority"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "priority": {
            "enum": [
              "required",
              "optional",
              "curious"
            ]
          },
          "minimumNights": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          },
          "maximumNights": {
            "type": "integer",
            "minimum": 0,
            "maximum": 90
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pace",
        "directFlightBias",
        "hotelLocationBias",
        "activityThemes"
      ],
      "properties": {
        "pace": {
          "enum": [
            "relaxed",
            "balanced",
            "packed"
          ]
        },
        "directFlightBias": {
          "$ref": "#/$defs/weight"
        },
        "hotelLocationBias": {
          "$ref": "#/$defs/weight"
        },
        "activityThemes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "pointValuations": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "description": "Traveler-supplied value in currency units per point"
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "label",
          "locked"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "placeId": {
            "$ref": "#/$defs/id"
          },
          "locked": {
            "type": "boolean"
          }
        }
      }
    },
    "routeCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "status",
          "placeOrder"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "status": {
            "$ref": "#/$defs/decisionStatus"
          },
          "placeOrder": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "score": {
            "type": "number"
          },
          "scoreReasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240
            }
          }
        }
      }
    },
    "bookings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "startAt",
          "endAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "flight",
              "rail",
              "car",
              "stay",
              "activity",
              "ferry",
              "bus",
              "other"
            ]
          },
          "status": {
            "$ref": "#/$defs/decisionStatus"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "provider": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decisionStatus": {
      "enum": [
        "recommended",
        "quoted",
        "held",
        "confirmed",
        "missing",
        "conflict"
      ]
    }
  }
}
